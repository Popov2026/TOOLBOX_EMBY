# Stunt Car Racer natif : réglages (clé = valeur). Les options en ligne de commande priment.
# disk = Stunt_Car_Racer.st   # image disque (sinon : premier .st du dossier DISK)
# track = 1                   # 1..8 : entraînement direct sur ce circuit ; absent : jeu complet
scale = 3                     # taille de la fenêtre (× 320×200)
fullscreen = 0
smooth = 0                    # 1 : lissage à l'agrandissement
speed = 1                     # vitesse de la machine (1 = 50 Hz d'origine)
son = 1                       # 0 : sans son (F3 en jeu)
volume = 0.8                  # 0 à 2
hd = 0                        # 1 : démarrer en mode HD (touche F1 pour basculer)
details = 0                   # 1 : démarrer en détails élevés (touche F5 : sols et voiture texturés, roues rondes)
hdres = 1920x1080             # définition du mode HD (16/9)
ombres = 1                    # HD : ombres sous les voitures
particules = 1                # HD : étincelles et fumée lors des chocs et des réceptions brutales
lissage = 1                   # HD : lissage des bords (anticrénelage)
ciel = 1                      # HD : ciel dégradé avec nuages qui dérivent et soleil (0 : ciel uni d'origine)
decor = 1                     # HD : tribunes avec public, panneaux publicitaires et arbres autour des circuits
foule = 1                     # HD : encouragements de la foule devant les tribunes (effet Doppler)
textures_hd = 1               # HD : images du dossier hd (cockpit, sprites) ; 0 : graphismes d'origine agrandis
manette = 1                   # 0 : manette ignorée
vibrations = 1                # vibrations de la manette lors des chocs
# touches de conduite (noms SDL : Up, Down, Left, Right, Space, W, A, S, D, Left Shift...) ;
# les flèches restent toujours actives. Réglables dans le menu d'options (touche F8).
# touche_accelerer = Up
# touche_freiner = Down
# touche_gauche = Left
# touche_droite = Right
# touche_boost = Space
# hddir = hd                  # dossier des images de remplacement (défaut : hd à côté de scr.exe)
# (les flammes HD suivent l option textures_hd)
#                              (par défaut : sprites d'origine agrandis, les images de flammes sont ignorées)

# --- circuits TNT (Stunt Car Racer « The New Tracks », version Amiga) : fichier de l'utilisateur
# tnt = TNT/StuntCarRacerTNT_v1.4.lha   # SCR-TNT ou archive .lha (défaut : cherché dans le dossier TNT)
# circuits = tnt                        # tout le jeu sur les circuits TNT (défaut : circuits d'origine)

# --- multijoueur (mode « Computer Link » par le réseau ; voir LISEZMOI_MULTIJOUEUR.txt)
# nom = Pierre                # pseudo en multijoueur online, 12 caractères (aussi réglable dans le menu)
# serveur relais pour jouer par Internet (menu « 4. Online Multiplayer »). Vide : serveur officiel.
# Pour un autre serveur, par exemple :
#   relais = 192.168.1.110:27420     (attention : pas de # en début de ligne, sinon elle est ignorée)
# L'adresse peut aussi être saisie dans le menu « 4. Online Multiplayer » : elle est enregistrée ici.
relais =
reseau_cadence = 400          # échanges réseau par seconde pendant une partie (50 à 2000) : plus haut = moins de lag

# --- physique d'origine (1 = valeur du jeu)
gravity = 1
thrust = 1
brake = 1
timestep = 1
damping = 1
boostuse = 1
# shock = 0                   # tolérance aux chocs
